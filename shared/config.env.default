# QnapAssistant persistent configuration.
# LLM provider: local = bundled llama.cpp / GGUF, openrouter = OpenRouter API.
LLM_PROVIDER=local
# Independent local LLM residency. 0 keeps it hot; 1 unloads after idle timeout.
LLM_AUTO_UNLOAD=0
LLM_IDLE_TIMEOUT_SECONDS=300

MODEL_PATH=/share/Public/Qwen3-0.6B-Q8_0.gguf
MODEL_DIR=/share/Public
MODEL_URL=https://huggingface.co/Qwen/Qwen3-0.6B-GGUF/resolve/1eaf4d9657fe65ad10a51eab76a8db5b363bddaa/Qwen3-0.6B-Q8_0.gguf?download=true
MODEL_SHA256=9465e63a22add5354d9bb4b99e90117043c7124007664907259bd16d043bb031
MIN_MODEL_BYTES=100000000

ADMIN_PORT=11435
BACKEND_PORT=11436
THREADS=4
THREADS_BATCH=4
CONTEXT=4096
BATCH=256
UBATCH=128
PARALLEL=1
THINKING_MODE=off
# Legacy compatibility keys. New code uses LLM_AUTO_UNLOAD/LLM_IDLE_TIMEOUT_SECONDS.
KEEP_MODELS_LOADED=1
IDLE_TIMEOUT_SECONDS=0
EXTRA_ARGS=

# OpenRouter. API key is intentionally NOT stored in this file; set it through
# /api/openrouter/key or the web UI. It is stored separately with mode 0600.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# Comma-separated ordered fallback models. Empty = primary only.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_PRESET=
# Blank temperature/top_p = keep QnapAssistant voice default/request value.
OPENROUTER_TEMPERATURE=
OPENROUTER_TOP_P=
# Blank/default lets the selected model decide. Common values include low/medium/high.
OPENROUTER_REASONING_EFFORT=
# Blank, price, throughput, or latency.
OPENROUTER_PROVIDER_SORT=
OPENROUTER_ALLOW_FALLBACKS=1
OPENROUTER_REQUIRE_PARAMETERS=0
# Blank, allow, or deny.
OPENROUTER_DATA_COLLECTION=
# Blank = normal OpenRouter routing; 1 requests zero-data-retention endpoints.
OPENROUTER_ZDR=
# Comma-separated provider slugs.
OPENROUTER_PROVIDER_ONLY=
OPENROUTER_PROVIDER_IGNORE=
# Optional provider price ceilings in dollars per million tokens.
OPENROUTER_MAX_PRICE_PROMPT=
OPENROUTER_MAX_PRICE_COMPLETION=
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=QnapAssistant

VOICE_PORT=11437
VOICE_DIR=/share/Public/QnapAssistant/voice
ASR_MODEL_DIR=/share/Public/QnapAssistant/voice/sensevoice
TTS_MODEL_DIR=/share/Public/QnapAssistant/voice/supertonic3
ASR_LANGUAGE=ja
TTS_LANGUAGE=ja
ASR_THREADS=4
TTS_THREADS=2
TTS_STEPS=4
TTS_SPEED=1.0
TTS_SID=0
VOICE_MAX_TOKENS=128
# ASR and TTS residency are independent. When enabled, only that model/session
# is unloaded after the timeout; the voice worker stays available and reloads lazily.
ASR_AUTO_UNLOAD=0
ASR_IDLE_TIMEOUT_SECONDS=300
TTS_AUTO_UNLOAD=0
TTS_IDLE_TIMEOUT_SECONDS=300
# 0 = omit max_tokens and inherit the selected LLM backend's standard limit.
# Set 1..2048 only when an explicit voice reply cap is wanted.
VOICE_REPLY_MAX_TOKENS=0
VOICE_REPLY_TEMPERATURE=0.2
VOICE_SYSTEM_PROMPT=あなたは音声アシスタントです。ユーザーの発話内容を踏まえて自然な日本語で答えてください。入力内容をそのまま繰り返すだけの返答を避け、質問や依頼に直接答えてください。説明が必要な場合は省略せず、内容に応じた必要十分な長さで回答してください。音声で不自然なMarkdown記号や絵文字は避けてください。

# Voice client profiles. Requests can override with ?profile= or X-Qnap-Voice-Profile.
VOICE_PROFILE_DEFAULT=generic
# Generic/current compatibility profile.
VOICE_GENERIC_SAMPLE_RATE=0
VOICE_GENERIC_PEAK_TARGET=0
VOICE_GENERIC_STRIP_EMOJI=0
VOICE_GENERIC_STREAM_FORMAT=ndjson
VOICE_GENERIC_CHUNK_MIN_CHARS=12
VOICE_GENERIC_CHUNK_MAX_CHARS=28
# M5GO constrained profile: 16 kHz, conservative peak limiting, no emoji,
# and multipart binary audio so ESP32 clients never hold base64 JSON blobs.
VOICE_M5_SAMPLE_RATE=16000
VOICE_M5_PEAK_TARGET=0.12
VOICE_M5_STRIP_EMOJI=1
VOICE_M5_STREAM_FORMAT=multipart
VOICE_M5_CHUNK_MIN_CHARS=8
VOICE_M5_CHUNK_MAX_CHARS=18
