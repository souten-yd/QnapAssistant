# QnapAssistant persistent configuration.
# Default Qwen3-0.6B model is stored directly in /share/Public as requested.
MODEL_PATH=/share/Public/Qwen3-0.6B-Q8_0.gguf
MODEL_DIR=/share/Public
MODEL_URL=https://huggingface.co/Qwen/Qwen3-0.6B-GGUF/resolve/1eaf4d9657fe65ad10a51eab76a8db5b363bddaa/Qwen3-0.6B-Q8_0.gguf?download=true
MODEL_SHA256=9465e63a22add5354d9bb4b99e90117043c7124007664907259bd16d043bb031
MIN_MODEL_BYTES=100000000

# Lightweight management API. llama-server listens only on localhost behind it.
ADMIN_PORT=11435
BACKEND_PORT=11436

# llama.cpp defaults tuned for Intel Celeron J3455 / TS-253Be.
THREADS=4
THREADS_BATCH=4
CONTEXT=4096
BATCH=256
UBATCH=128
PARALLEL=1

# Qwen3 thinking control for /v1/chat/completions: off, on, or passthrough.
# Explicit /think or /no_think in a request always wins. Default off is faster
# for the short assistant workloads targeted by this NAS package.
THINKING_MODE=off

# 0 disables unloading. Default: unload the model after 5 idle minutes.
IDLE_TIMEOUT_SECONDS=300

# Advanced llama-server options. Quoted arguments are supported.
EXTRA_ARGS=
